{
  "name": "ardi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ARDI_BUILD_TARGET=ardia vite build --watch --mode development",
    "build": "tsc --noEmit && bun run build:ardia && bun run build:chrome",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "bun test",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "zip": "bun run build && bun scripts/zip.ts",
    "host:install": "bun scripts/install-host.ts",
    "build:ardia": "ARDI_BUILD_TARGET=ardia vite build",
    "build:chrome": "ARDI_BUILD_TARGET=chrome vite build",
    "dev:chrome": "ARDI_BUILD_TARGET=chrome vite build --watch --mode development",
    "release:package": "bun run build && bun scripts/package-release.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  }
}
